{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "8",
    "CLAUDE_STACK_MAX_DEPTH": "8",
    "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "20",
    "CLAUDE_CODE_WORKFLOW_MAX_CONCURRENT_AGENTS": "16",
    "MAX_MCP_OUTPUT_TOKENS": "40000"
  },
  "availableModels": [
    "claude-opus-5-5",
    "claude-sonnet-5-5",
    "claude-haiku-5-5"
  ],
  "enforceAvailableModels": true,
  "enabledMcpjsonServers": [],
  "permissions": {
    "allow": [
      "Bash(bin/stack *)",
      "Bash(./bin/stack *)",
      "mcp__exa",
      "mcp__jina",
      "mcp__spider",
      "mcp__image",
      "mcp__context7",
      "mcp__desktop-sandbox",
      "Workflow(swarm-run)",
      "Workflow(fanout)",
      "Workflow(mediate)",
      "Workflow(expert-panel)",
      "Workflow(research-sweep)",
      "Workflow(review-verify)",
      "Workflow(plan-tournament)",
      "Workflow(visual-iterate)",
      "Workflow(manuscript-review)",
      "mcp__fetch",
      "mcp__neural-memory"
    ],
    "deny": [
      "Read(~/.claude/stack.env)",
      "Bash(cat ~/.claude/stack.env*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/bin/stack hook session-start",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/bin/stack hook pre-agent",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit|mcp__playwright__browser_type|mcp__playwright__browser_fill_form|mcp__playwright__browser_file_upload|mcp__playwright__browser_press_key|mcp__desktop-sandbox__(type_text|key|launch|put_file|click|drag|scroll|move)|mcp__neural-memory__.*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/bin/stack hook pre-tool",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/bin/stack hook subagent-stop",
            "async": true,
            "timeout": 120
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/bin/stack hook session-end",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/bin/stack hook prompt-submit",
            "timeout": 20
          }
        ]
      }
    ],
    "PreModelSwitch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/bin/stack hook model-switch",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "WebFetch|WebSearch|mcp__fetch__.*|mcp__jina__.*|mcp__exa__.*|mcp__spider__.*|mcp__playwright__.*|mcp__firecrawl__.*|mcp__tavily__.*|mcp__brave-search__.*|mcp__markitdown__.*|mcp__desktop-sandbox__.*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/bin/stack hook post-web",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
