{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "8",
    "CLAUDE_STACK_MAX_DEPTH": "8",
    "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "20",
    "CLAUDE_CODE_WORKFLOW_MAX_CONCURRENT_AGENTS": "16",
    "MAX_MCP_OUTPUT_TOKENS": "40000"
  },
  "availableModels": [
    "claude-opus-5-5",
    "claude-sonnet-5-5",
    "claude-haiku-5-5"
  ],
  "availableModelsMatch": "exact",
  "enforceAvailableModels": true,
  "enabledMcpjsonServers": [
    "playwright",
    "exa",
    "jina",
    "spider",
    "context7",
    "image"
  ],
  "permissions": {
    "allow": [
      "Bash(bin/stack *)",
      "Bash(./bin/stack *)",
      "mcp__exa",
      "mcp__jina",
      "mcp__spider",
      "mcp__image",
      "mcp__context7",
      "Workflow(swarm-run)",
      "Workflow(fanout)",
      "Workflow(mediate)",
      "Workflow(expert-panel)",
      "Workflow(research-sweep)",
      "Workflow(review-verify)",
      "Workflow(plan-tournament)",
      "Workflow(visual-iterate)"
    ],
    "deny": [
      "Read(~/.claude/stack.env)",
      "Bash(cat ~/.claude/stack.env*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/bin/stack hook session-start",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/bin/stack hook pre-agent",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/bin/stack hook subagent-stop",
            "async": true,
            "timeout": 120
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/bin/stack hook session-end",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/bin/stack hook prompt-submit",
            "timeout": 20
          }
        ]
      }
    ],
    "PreModelSwitch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/bin/stack hook model-switch",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
