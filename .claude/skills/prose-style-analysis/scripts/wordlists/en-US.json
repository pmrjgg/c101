 "confused_words": [
  {
   "hint": "your/you're: 'you're' expected before a verb or adjective",
   "pattern": "(?i:\\byour\\s+(?:welcome|going|not|being|doing|right|wrong|so|too)\\b)"
  },
  {
   "hint": "you're/your: 'your' expected before a noun",
   "pattern": "(?i:\\byou're\\s+(?:own|car|house|eyes|hands|mother|father|name|self)\\b)"
  },
  {
   "hint": "it's/its: 'its' expected as possessive",
   "pattern": "(?i:\\bit's\\s+(?:own|tail|head|color|colour|eyes|surface|owner)\\b)"
  },
  {
   "hint": "then/than: 'than' expected in comparisons",
   "pattern": "(?i:\\b(?:more|less|better|worse|rather|other|bigger|smaller|faster|slower|older|younger|taller|larger|greater|fewer|harder|stronger|weaker|higher|lower)\\s+then\\b)"
  },
  {
   "hint": "'could of' for 'could have'",
   "pattern": "(?i:\\b(?:could|would|should|must|might)\\s+of\\b)"
  },
  {
   "hint": "loose/lose: 'lose' (verb) expected",
   "pattern": "(?i:\\b(?:to|will|would|might|could|can't|cannot|don't|didn't|won't)\\s+loose\\b)"
  },
  {
   "hint": "affect/effect: 'effect' (noun) expected",
   "pattern": "(?i:\\b(?:the|an?|no|any|some)\\s+affect\\b)"
  },
  {
   "hint": "effect/affect: 'affect' (verb, to influence) expected unless 'effect change'",
   "pattern": "(?i:\\b(?:to|will|would|can|could|might|may)\\s+effect\\b)"
  },
  {
   "hint": "their/there/they're: 'there' expected before is/are/was/were",
   "pattern": "(?i:\\b(?:they're|their)\\s+(?:is|are|was|were)\\b)"
  },
  {
   "hint": "there/their: 'their' expected before a noun",
   "pattern": "(?i:\\bthere\\s+(?:own|car|house|eyes|hands|mother|father|names?)\\b)"
  },
  {
   "hint": "they're/their: 'their' expected before a noun",
   "pattern": "(?i:\\bthey're\\s+(?:own|car|house|eyes|hands|names?)\\b)"
  },
  {
   "hint": "who's/whose: 'whose' expected as possessive",
   "pattern": "(?i:\\bwho's\\s+(?:book|car|house|idea|turn|fault|coat)\\b)"
  },
  {
   "hint": "to/too: 'too' expected before an adjective or adverb",
   "pattern": "(?i:\\bto\\s+(?:much|many|late|early|soon|long|far|tired|afraid|tall|small)\\b)"
  },
  {
   "hint": "too/to: 'to' expected before a verb",
   "pattern": "(?i:\\btoo\\s+(?:go|do|be|have|see|say|make|get|take|come)\\b)"
  },
  {
   "hint": "breath/breathe: 'breath' (noun) expected",
   "pattern": "(?i:\\b(?:a|the)\\s+breathe\\b)"
  },
  {
   "hint": "breathe/breath: 'breathe' (verb) expected",
   "pattern": "(?i:\\b(?:to|can|could|will|would|didn't|couldn't)\\s+breath\\b)"
  },
  {
   "hint": "peek/peak: 'sneak peek'",
   "pattern": "(?i:\\bsneak\\s+peak\\b)"
  },
  {
   "hint": "whether/weather: 'whether or not'",
   "pattern": "(?i:\\bweather\\s+or\\s+not\\b)"
  },
  {
   "hint": "advise/advice: 'advise' (verb) expected",
   "pattern": "(?i:\\bto\\s+advice\\b)"
  },
  {
   "hint": "'a lot' is two words",
   "pattern": "(?i:\\balot\\b)"
  },
  {
   "hint": "'regardless' expected",
   "pattern": "(?i:\\birregardless\\b)"
  },
  {
   "hint": "'for all intents and purposes'",
   "pattern": "(?i:\\bfor\\s+all\\s+intensive\\s+purposes\\b)"
  },
  {
   "hint": "faze/phase: 'faze' (to disturb) expected",
   "pattern": "(?i:\\bphase\\s+(?:me|him|her|them|us)\\b)"
  },
  {
   "hint": "'intact' is one word",
   "pattern": "(?i:\\bin\\s+tact\\b)"
  },
  {
   "hint": "'piqued' expected",
   "pattern": "(?i:\\bpeaked\\s+(?:my|his|her|their|our)\\s+interest\\b)"
  },
  {
   "hint": "'champing at the bit' is the traditional form",
   "pattern": "(?i:\\bchomping\\s+at\\s+the\\s+bit\\b)"
