# ~/.claude/stack.env — API keys for the agent stack. Copy this file there and
# `chmod 600 ~/.claude/stack.env`. It is PARSED (KEY=VALUE lines only), never
# sourced, by bin/mcp-run and bin/mcp-headers. Leave a value empty to disable
# that provider; routers skip providers without keys.
#
# Check what is set (names only):  bin/stack keys
#
# Running every image operation on fal? Start from config/stack.env.fal.example instead.

# --- web research / crawling (remote MCP servers via headersHelper) ---------
EXA_API_KEY=            # https://dashboard.exa.ai/api-keys   (exa: works anonymously with rate limits)
JINA_API_KEY=           # https://jina.ai/api-dashboard       (jina: read_url works without; search needs it)
SPIDER_API_KEY=         # https://spider.cloud/api-keys       (spider: required)
CONTEXT7_API_KEY=       # https://context7.com/dashboard      (optional; higher rate limits)

# --- images: one endpoint per operation (BYOK; no fallbacks) ---------------
# Each operation of the `image` MCP server uses exactly the endpoint, key and model tag set
# here, and its tool is EXPOSED ONLY when all three are set (restart/reconnect the server via
# /mcp after editing). Point URLs at your router:
#   OpenRouter  https://openrouter.ai/api/v1     Opper  https://api.opper.ai     fal  https://queue.fal.run
# The protocol is detected from the URL host; force it with IMAGE_<OP>_API=openrouter|opper|openai|fal
# (TRACE and UPSCALE also accept IMAGE_<OP>_API=local: deterministic, no URL/KEY needed).
# Optional IMAGE_<OP>_PARAMS='{"quality":"high"}' adds fixed request parameters.
IMAGE_GEN_URL=                 # text-to-image                       -> image_generate
IMAGE_GEN_KEY=
IMAGE_GEN_MODEL=               # e.g. google/gemini-nano-banana-2.1
IMAGE_REF_URL=                 # generation with reference images    -> image_generate_with_references
IMAGE_REF_KEY=
IMAGE_REF_MODEL=               # e.g. openai/gpt-image-2.5-sunburst
IMAGE_EDIT_URL=                # instruction edits / masked inpaint  -> image_edit
IMAGE_EDIT_KEY=
IMAGE_EDIT_MODEL=
IMAGE_TRANSPARENT_URL=         # transparent (RGBA) generation       -> image_generate_transparent
IMAGE_TRANSPARENT_KEY=
IMAGE_TRANSPARENT_MODEL=       # e.g. openai/gpt-image-2.5-flare
IMAGE_SEGMENT_URL=             # segmentation: prompt -> mask PNG    -> image_segment
IMAGE_SEGMENT_KEY=
IMAGE_SEGMENT_MODEL=           # e.g. fal-ai/sam-3/image (fal) or an image model that draws masks
IMAGE_BG_REMOVAL_URL=          # background removal -> RGBA cutout   -> image_remove_background
IMAGE_BG_REMOVAL_KEY=
IMAGE_BG_REMOVAL_MODEL=        # e.g. fal-ai/bria/background/remove (fal)
IMAGE_UPSCALE_URL=             # upscaling                           -> image_upscale
IMAGE_UPSCALE_KEY=
IMAGE_UPSCALE_MODEL=           # e.g. fal-ai/topaz/upscale/image (fal), or IMAGE_UPSCALE_API=local
IMAGE_VECTOR_URL=              # native SVG generation               -> vector_generate
IMAGE_VECTOR_KEY=
IMAGE_VECTOR_MODEL=            # e.g. recraft/recraft-v4.1-vector
IMAGE_TRACE_URL=               # raster -> vector tracing            -> image_vectorize
IMAGE_TRACE_KEY=
IMAGE_TRACE_MODEL=             # e.g. fal-ai/recraft/vectorize (fal), or IMAGE_TRACE_API=local
IMAGE_VECTOR_MANIPULATION_MODEL=claude   # 'claude' (default): agents edit SVG themselves; svg_transform hidden
IMAGE_VECTOR_MANIPULATION_URL=           # set URL/KEY/MODEL to expose svg_transform with an external model
IMAGE_VECTOR_MANIPULATION_KEY=

# --- example: route operations to fal (uncomment the ops you want) -----------
# fal speaks its queue API: URL is always https://queue.fal.run, KEY is your fal key
# (https://fal.ai/dashboard/keys), MODEL is the fal endpoint id exactly as shown on
# https://fal.ai/models/<endpoint-id>. One fal key serves every operation: repeat it in each
# IMAGE_<OP>_KEY you point at fal. IMAGE_<OP>_API=fal is optional (the fal host already selects
# the protocol). An uncommented line here overrides the empty one above (the last assignment
# wins), and the op's tool appears once URL, KEY and MODEL are all set.
#
# IMAGE_GEN_URL=https://queue.fal.run
# IMAGE_GEN_KEY=your-fal-key
# IMAGE_GEN_MODEL=fal-ai/flux-pro/v1.1-ultra
#
# IMAGE_EDIT_URL=https://queue.fal.run
# IMAGE_EDIT_KEY=your-fal-key
# IMAGE_EDIT_MODEL=fal-ai/nano-banana-2.1/edit       # masked inpaint instead: fal-ai/flux-pro/v1/fill
#
# IMAGE_SEGMENT_URL=https://queue.fal.run
# IMAGE_SEGMENT_KEY=your-fal-key
# IMAGE_SEGMENT_MODEL=fal-ai/sam-3/image
#
# IMAGE_BG_REMOVAL_URL=https://queue.fal.run
# IMAGE_BG_REMOVAL_KEY=your-fal-key
# IMAGE_BG_REMOVAL_MODEL=fal-ai/bria/background/remove
#
# IMAGE_UPSCALE_URL=https://queue.fal.run
# IMAGE_UPSCALE_KEY=your-fal-key
# IMAGE_UPSCALE_MODEL=fal-ai/topaz/upscale/image
# optional fixed request parameters (keep a quoted value alone on its line, no trailing comment):
# IMAGE_UPSCALE_PARAMS='{"upscale_factor":2}'
#
# IMAGE_VECTOR_URL=https://queue.fal.run
# IMAGE_VECTOR_KEY=your-fal-key
# IMAGE_VECTOR_MODEL=fal-ai/recraft/v4.1/text-to-vector
#
# IMAGE_TRACE_URL=https://queue.fal.run
# IMAGE_TRACE_KEY=your-fal-key
# IMAGE_TRACE_MODEL=fal-ai/recraft/vectorize
#
# FAL_KEY=your-fal-key        # only for fal's hosted MCP server (bin/stack mcp enable fal)

# --- optional fallbacks (see config/mcp.optional.json) -----------------------
FIRECRAWL_API_KEY=
TAVILY_API_KEY=
BRAVE_API_KEY=
RUNWARE_API_KEY=

# --- sandboxed computer use (desktop-sandbox MCP server; all optional) ------
# This server receives ONLY DESKTOP_SANDBOX_* lines (bin/mcp-run --only), never your keys.
# Build the image once:  bin/desktop-sandbox --build --profile recommended      Check:  bin/desktop-sandbox --check
# Profiles:              bin/desktop-sandbox --list-profiles   (operator, tester, recommended)
# DESKTOP_SANDBOX_RUNTIME=docker          # docker | podman | absolute path (default: first found)
# DESKTOP_SANDBOX_NETWORK=none            # none (default) | bridge = the sandbox may reach the internet
# DESKTOP_SANDBOX_SIZE=1280x800           # WxH, clamped to 640..1920 x 480..1200
# DESKTOP_SANDBOX_MAX_MINUTES=30          # hard lifetime (1..120)
# DESKTOP_SANDBOX_IDLE_MINUTES=10         # stop after this long without an action (1..60)
# DESKTOP_SANDBOX_MAX_ACTIONS=600         # input actions per sandbox (10..5000)
# DESKTOP_SANDBOX_MEMORY=2g               # 512m..99g
# DESKTOP_SANDBOX_CPUS=2
