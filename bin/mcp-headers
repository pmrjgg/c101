#!/usr/bin/env bash
# headersHelper for remote (http) MCP servers: prints a JSON object of auth
# headers built from keys in ~/.claude/stack.env. Claude Code runs this on each
# connection (10 s limit) and strips credential-looking env vars before it does,
# so the helper reads the env file itself.
#
#   bin/mcp-headers <exa|fal|jina|spider|context7|firecrawl|tavily>
#
# Prints {} when the key is missing so anonymous/free tiers still connect.
set -euo pipefail

STACK_ENV="${CLAUDE_STACK_ENV:-${HOME:-/nonexistent}/.claude/stack.env}"
service="${1:-${CLAUDE_CODE_MCP_SERVER_NAME:-}}"

getkey() {
  # Same rules as bin/mcp-run and stack/envfile.py: KEY=VALUE lines only, the last assignment wins.
  local want="$1" line key val found="" out=""
  [[ -f "$STACK_ENV" ]] || return 0
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line#"${line%%[![:space:]]*}"}"
    [[ -z "$line" || "$line" == \#* ]] && continue
    line="${line#export }"
    [[ "$line" == *=* ]] || continue
    key="${line%%=*}"
    [[ "$key" == "$want" ]] || continue
    val="${line#*=}"
    if [[ "$val" =~ ^\"(.*)\"$ ]] || [[ "$val" =~ ^\'(.*)\'$ ]]; then
      val="${BASH_REMATCH[1]}"
    else
      # unquoted: drop an inline " # comment" and surrounding whitespace
      val="${val%%[[:space:]]#*}"
      val="${val#"${val%%[![:space:]]*}"}"
      val="${val%"${val##*[![:space:]]}"}"
    fi
    found=1 out="$val"
  done < "$STACK_ENV"
  [[ -n "$found" ]] && printf '%s' "$out"
  return 0
}

json_escape() { local s="$1"; s="${s//\\/\\\\}"; s="${s//\"/\\\"}"; printf '%s' "$s"; }

emit() { # emit <header-name> <value-prefix> <key-var>
  local v
  v="$(getkey "$3")"
  if [[ -z "$v" ]]; then echo '{}'; return 0; fi
  printf '{"%s":"%s%s"}\n' "$1" "$2" "$(json_escape "$v")"
}

case "$service" in
  exa)        emit "x-api-key" "" EXA_API_KEY ;;
  fal)        emit "Authorization" "Key " FAL_KEY ;;
  jina)       emit "Authorization" "Bearer " JINA_API_KEY ;;
  spider)     emit "Authorization" "Bearer " SPIDER_API_KEY ;;
  context7)   emit "Authorization" "Bearer " CONTEXT7_API_KEY ;;
  firecrawl)  emit "Authorization" "Bearer " FIRECRAWL_API_KEY ;;
  tavily)     emit "Authorization" "Bearer " TAVILY_API_KEY ;;
  *) echo "mcp-headers: unknown service '$service'" >&2; echo '{}' ;;
esac
